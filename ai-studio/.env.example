# Публичный адрес сайта (влияет на canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://aillix.ru

# ---- Заявки: Telegram ----
# Один бот может отправлять в два чата. Если чаты в разных ботах — задайте второй токен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_1=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=
# Опционально: прокси/релей Bot API, если api.telegram.org недоступен с сервера
TELEGRAM_API_BASE=

# ---- Заявки: e-mail (SMTP) ----
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=robot@aillix.ru
SMTP_PASS=
LEAD_EMAIL_FROM="Aillix <robot@aillix.ru>"
LEAD_EMAIL_TO_1=pochta.samara163@mail.ru
LEAD_EMAIL_TO_2=gmusina@list.ru

# ---- Заявки: VK ----
# Токен сообщества с правом messages; пользователь должен разрешить сообщения.
VK_GROUP_TOKEN=
VK_USER_ID=1018631057
VK_API_VERSION=5.199

# ---- Хранение заявок ----
# JSONL-файл на persistent volume. В Docker: ./data:/app/data
LEAD_STORE_PATH=data/leads.jsonl
LEAD_STORE_DISABLED=false

# ---- Аналитика и антиспам ----
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=
