# =============================================================================
# Aillix — переменные окружения
# Скопируйте в .env и заполните секреты:
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# ---- Публичный адрес сайта (canonical, sitemap, OG) ----
NEXT_PUBLIC_SITE_URL=https://aillix.ru
APP_VERSION=latest

# ---- PostgreSQL ----
POSTGRES_DB=aillix
POSTGRES_USER=aillix
POSTGRES_PASSWORD=change_me_strong_db_password

# ---- Nginx (loopback-порт для host Nginx) ----
NGINX_PUBLISH_PORT=8080

# ---- FastAPI backend ----
# Внутри compose hostname сервиса — backend, порт не публикуется.
API_INTERNAL_URL=http://backend:8000
BACKEND_CORS_ORIGINS=https://aillix.ru
BACKEND_LOG_LEVEL=INFO
# Публичные OpenAPI-доки выключены в проде; включать только локально.
BACKEND_DOCS_ENABLED=false

# ---- JWT (admin) ----
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change_me_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- Первичный администратор ----
# Создаётся при первом старте backend ТОЛЬКО если в таблице admins нет записей.
ADMIN_EMAIL=admin@aillix.ru
ADMIN_PASSWORD=change_me_admin_password

# ---- pgAdmin (профиль tools) ----
PGADMIN_DEFAULT_EMAIL=admin@aillix.ru
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_PUBLISH_PORT=5050

# ---- Локальный Docker Registry (профиль tools) ----
REGISTRY_HOST=registry.aillix.ru
REGISTRY_PUBLISH_PORT=5000
REGISTRY_HTTP_SECRET=change_me_registry_secret

# ---- Watchtower (профиль tools) ----
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_SCHEDULE=0 0 4 * * *

# ---- Заявки: Telegram ----
# В учебном контуре внешняя доставка выключена: данные не покидают сервер.
# Включать только при явном согласии на передачу персональных данных.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_1=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=
TELEGRAM_API_BASE=

# ---- Заявки: e-mail (SMTP) ----
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_FROM="Aillix <robot@aillix.ru>"
LEAD_EMAIL_TO_1=
LEAD_EMAIL_TO_2=

# ---- Заявки: VK ----
VK_GROUP_TOKEN=
VK_USER_ID=
VK_API_VERSION=5.199

# ---- Доставка во внешние каналы ----
# false — заявки остаются в PostgreSQL и никуда не пересылаются.
LEAD_EXTERNAL_DELIVERY=false

# ---- Хранение старых заявок (архив JSONL) ----
# Оставлено только для чтения архива; новые заявки пишутся в PostgreSQL.
LEAD_STORE_PATH=data/leads.jsonl
LEAD_STORE_DISABLED=true

# ---- Аналитика и антиспам ----
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=
